<Window x:Class="FinanzasPersonales.Windows.IngresoLaboralWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DMT Finance — Registrar ingreso"
        Icon="/Assets/dmt-logo.png"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}">

    <Grid>
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="380"
                Margin="0,32"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="36,32">
            <StackPanel>

                <TextBlock Text="Registrar ingreso laboral"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Revisa y ajusta los datos antes de confirmar."
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <!-- Fecha -->
                <TextBlock Text="Fecha (dd/MM/yyyy)"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtFecha"
                         Margin="0,0,0,16"/>

                <!-- Monto -->
                <TextBlock Text="Monto"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtMonto"
                         Margin="0,0,0,16"/>

                <!-- Descripción -->
                <TextBlock Text="Descripción"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtDescripcion"
                         Margin="0,0,0,16"/>

                <!-- Cuenta -->
                <TextBlock Text="Acreditar a cuenta (opcional)"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                <ComboBox x:Name="CboCuentas"
                          DisplayMemberPath="Nombre"
                          Margin="0,0,0,24"/>

                <!-- Error -->
                <TextBlock x:Name="TxtError"
                           Foreground="{DynamicResource RedBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"
                           Visibility="Collapsed"/>

                <!-- Botones -->
                <Button Content="Confirmar ingreso"
                        Style="{StaticResource PrimaryButton}"
                        Height="42" FontSize="14"
                        Margin="0,0,0,10"
                        Click="BtnConfirmar_Click"/>

                <Button Content="Cancelar"
                        Style="{StaticResource SecondaryButton}"
                        Height="36"
                        Click="BtnCancelar_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
