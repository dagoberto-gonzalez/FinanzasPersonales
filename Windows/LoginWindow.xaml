<Window x:Class="FinanzasPersonales.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DMT Finance — Iniciar Sesión"
        Icon="/Assets/dmt-logo.png"
        Width="440" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E2E">

    <Grid>
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="360"
                Background="#24273A"
                BorderBrush="#3A3D52"
                BorderThickness="1"
                CornerRadius="16"
                Padding="36,40">
            <StackPanel>

                <!-- Logo DMT Finance -->
                <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                    <Canvas Width="64" Height="64">
                        <Rectangle Width="64" Height="64" RadiusX="14" RadiusY="14" Fill="#7C3AED"/>
                        <Rectangle Canvas.Left="9"  Canvas.Top="43" Width="13" Height="12" RadiusX="2.5" RadiusY="2.5" Fill="#66FFFFFF"/>
                        <Rectangle Canvas.Left="26" Canvas.Top="31" Width="13" Height="24" RadiusX="2.5" RadiusY="2.5" Fill="#A6FFFFFF"/>
                        <Rectangle Canvas.Left="43" Canvas.Top="17" Width="13" Height="38" RadiusX="2.5" RadiusY="2.5" Fill="White"/>
                        <Polyline Points="15.5,41 32.5,29 49.5,15"
                                  Stroke="White" StrokeThickness="2" Opacity="0.85"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        <Ellipse Canvas.Left="46.5" Canvas.Top="12" Width="6" Height="6" Fill="White" Opacity="0.9"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="DMT Finance"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#CDD6F4"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,4"/>
                <TextBlock Text="Inicia sesión para continuar"
                           FontSize="13"
                           Foreground="#6C7086"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,32"/>

                <!-- Usuario -->
                <TextBlock Text="Usuario"
                           Foreground="#6C7086"
                           FontSize="12"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="TxtUsuario"
                         Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Nombre de usuario"
                         Margin="0,0,0,16"
                         KeyDown="Input_KeyDown"/>

                <!-- Contraseña -->
                <TextBlock Text="Contraseña"
                           Foreground="#6C7086"
                           FontSize="12"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="PwdPassword"
                             Margin="0,0,0,8"
                             PasswordChanged="PwdPassword_PasswordChanged"
                             KeyDown="Input_KeyDown"/>

                <!-- Error -->
                <TextBlock Text="{Binding MensajeError}"
                           Foreground="#F38BA8"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"
                           Visibility="{Binding MensajeErrorVisibility}"/>

                <!-- Botón iniciar sesión -->
                <Button Content="Iniciar sesión"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding IniciarSesionCommand}"
                        Height="42"
                        FontSize="15"
                        Margin="0,0,0,12"/>

                <!-- Separador -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Separator Grid.Column="0" VerticalAlignment="Center" Background="#3A3D52"/>
                    <TextBlock Grid.Column="1" Text=" o " Foreground="#6C7086" FontSize="12" Margin="6,0"/>
                    <Separator Grid.Column="2" VerticalAlignment="Center" Background="#3A3D52"/>
                </Grid>

                <!-- Botón crear cuenta -->
                <Button Content="Crear cuenta nueva"
                        Style="{StaticResource SecondaryButton}"
                        Height="38"
                        FontSize="13"
                        Click="BtnCrearCuenta_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
