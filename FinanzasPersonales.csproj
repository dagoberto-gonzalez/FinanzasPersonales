<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FinanzasPersonales</RootNamespace>
    <AssemblyName>FinanzasPersonales</AssemblyName>
    <!-- Icono del .exe: escritorio, menú Inicio y barra de tareas. -->
    <ApplicationIcon>Assets\dmt-logo.ico</ApplicationIcon>
    <!-- Única fuente de la versión: el menú lateral la lee del ensamblado y el instalador del .exe. -->
    <Version>1.1.0</Version>
  </PropertyGroup>

  <!-- Excluir herramientas auxiliares y pruebas del build principal -->
  <ItemGroup>
    <Compile Remove="Tools\**" />
    <EmbeddedResource Remove="Tools\**" />
    <None Remove="Tools\**" />
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\dmt-logo.png"/>
  </ItemGroup>

  <!-- Las pruebas bajan Contrasenas.Iteraciones: crean un usuario por prueba. -->
  <ItemGroup>
    <InternalsVisibleTo Include="FinanzasPersonales.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="QuestPDF" Version="2025.1.0" />
  </ItemGroup>

</Project>
