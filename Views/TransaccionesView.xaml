<UserControl x:Class="FinanzasPersonales.Views.TransaccionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Transacciones" FontSize="26" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- ── Formulario nueva transacción (compacto) ────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>

                <!-- Fila 1: tipo + monto + categoría + fecha + guardar -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tipo: Gasto / Ingreso -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <RadioButton Content="Gasto"   IsChecked="{Binding EsGasto}"  GroupName="Tipo"/>
                        <RadioButton Content="Ingreso" IsChecked="{Binding EsIngreso}" GroupName="Tipo" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Separador visual -->
                    <Border Grid.Column="2" Width="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Stretch"/>

                    <!-- Monto -->
                    <TextBox Grid.Column="4"
                             Text="{Binding Monto, UpdateSourceTrigger=PropertyChanged}"
                             Tag="₡ Monto"/>

                    <!-- Categoría: visible en gastos e ingresos. Estuvo oculta en los ingresos,
                         pero Guardar() seguía escribiendo la categoría seleccionada, así que
                         todos los ingresos acababan en la primera de la lista sin que se viera. -->
                    <ComboBox Grid.Column="6"
                              ItemsSource="{Binding CategoriasForm}"
                              SelectedItem="{Binding Categoria}"/>

                    <!-- Fecha -->
                    <DatePicker Grid.Column="8"
                                    SelectedDate="{Binding Fecha}"
                                    FirstDayOfWeek="Monday"/>

                    <!-- Descripción -->
                    <TextBox Grid.Column="10"
                             Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Descripción (opcional)"/>

                    <!-- Guardar -->
                    <Button Grid.Column="12"
                            Content="Guardar"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding GuardarCommand}"
                            Padding="22,11"/>
                </Grid>

                <!-- Fila 2: método de pago + sub-tarjeta + notas -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding MetodosPago}"
                              SelectedItem="{Binding MetodoPago}"/>

                    <!-- Sub-selección: cuenta o tarjeta según el método (oculto en Efectivo) -->
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding SubItems}"
                              SelectedItem="{Binding SelectedSubItem}"
                              Visibility="{Binding MostrarSubItems, Converter={StaticResource BoolToVis}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Nombre}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EsEncabezado}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                    <Setter Property="FontSize"   Value="11"/>
                                                    <Setter Property="Margin"     Value="0,4,0,2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsEncabezado}" Value="True">
                                        <Setter Property="IsEnabled"  Value="False"/>
                                        <Setter Property="Focusable"  Value="False"/>
                                        <Setter Property="Padding"    Value="8,6,8,2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <TextBox Grid.Column="4"
                             Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Notas adicionales (opcional)"/>
                </Grid>

                <TextBlock Text="{Binding MensajeError}"
                           Foreground="{StaticResource RedBrush}"
                           FontSize="12" Margin="0,8,0,0"
                           Visibility="{Binding MensajeErrorVisibility}"/>
            </StackPanel>
        </Border>

        <!-- ── Filtros + búsqueda ─────────────────────────────────────────────── -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="138"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="88"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Buscar:"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding BusquedaTexto, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Descripción, categoría, cuenta..."/>

                <TextBlock Grid.Column="3" Text="Desde:"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker Grid.Column="4" SelectedDate="{Binding FiltroDesde}"/>

                <TextBlock Grid.Column="6" Text="Hasta:"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker Grid.Column="7" SelectedDate="{Binding FiltroHasta}"/>

                <TextBlock Grid.Column="9" Text="Categoría:"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="10"
                          ItemsSource="{Binding CategoriasFiltro}"
                          SelectedItem="{Binding FiltroCategoria}"/>

                <Button Grid.Column="12" Content="Filtrar"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding FiltrarCommand}"/>
                <Button Grid.Column="14" Content="Limpiar"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding LimpiarCommand}"
                        Click="BtnLimpiar_Click"/>
            </Grid>
        </Border>

        <!-- ── Tabla de transacciones (ocupa todo el espacio restante) ─────────── -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Transacciones}" Margin="0">
                <DataGrid.Columns>

                    <DataGridTextColumn Header="FECHA"
                                        Binding="{Binding Fecha, StringFormat='dd/MM/yyyy'}"
                                        Width="100"/>

                    <DataGridTemplateColumn Header="TIPO" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2"
                                        HorizontalAlignment="Left" Margin="0,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A3B2A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tipo}" Value="Gasto">
                                                    <Setter Property="Background" Value="#3B1A1A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Tipo}" FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tipo}" Value="Gasto">
                                                        <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="CATEGORÍA"
                                        Binding="{Binding Categoria}" Width="110"/>

                    <DataGridTextColumn Header="DESCRIPCIÓN"
                                        Binding="{Binding EtiquetaDisplay}" Width="*"/>

                    <DataGridTextColumn Header="CUENTA"
                                        Binding="{Binding CuentaNombre}" Width="120"/>

                    <DataGridTemplateColumn Header="MONTO" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Monto, StringFormat='₡{0:N0}'}"
                                           FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tipo}" Value="Gasto">
                                                    <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕"
                                        Style="{StaticResource DangerButton}"
                                        Padding="10,4"
                                        Command="{Binding DataContext.EliminarCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>
