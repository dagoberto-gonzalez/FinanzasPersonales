<UserControl x:Class="FinanzasPersonales.Views.MetasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" Text="Metas de Ahorro"
                   FontSize="26" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Formulario nueva meta -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Crear nueva meta"
                           FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Nombre de la meta"/>

                    <TextBox Grid.Column="2"
                             Text="{Binding MontoObjetivo, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Monto objetivo ($)"/>

                    <DatePicker Grid.Column="4"
                                    SelectedDate="{Binding FechaLimite}"
                                    FirstDayOfWeek="Monday"/>

                    <Button Grid.Column="6"
                            Content="Crear Meta"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CrearMetaCommand}"/>
                </Grid>

                <TextBlock Text="{Binding MensajeError}"
                           Foreground="{StaticResource RedBrush}"
                           FontSize="12" Margin="0,10,0,0"
                           Visibility="{Binding MensajeErrorVisibility}"/>
            </StackPanel>
        </Border>

        <!-- Lista de metas -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="No tienes metas de ahorro aún. ¡Crea una para empezar!"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="14" HorizontalAlignment="Center"
                           Margin="0,40,0,0"
                           Visibility="{Binding SinMetasVisibility}"/>

                <ItemsControl ItemsSource="{Binding Metas}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="300" Margin="0,0,16,16">
                                <StackPanel>

                                    <!-- Nombre -->
                                    <TextBlock Text="{Binding Nombre}"
                                               FontSize="17" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding FechaLimite, StringFormat='Vence: {0:dd/MM/yyyy}'}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12" Margin="0,0,0,12"/>

                                    <!-- Progreso -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding ProgresoTexto}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ProgresoPercent, StringFormat='{}{0:F0}%'}"
                                                   Foreground="{Binding ProgresBrush}"
                                                   FontSize="13" FontWeight="SemiBold"/>
                                    </Grid>

                                    <ProgressBar Maximum="100"
                                                 Value="{Binding ProgresoPercent, Mode=OneWay}"
                                                 Foreground="{Binding ProgresBrush}"
                                                 Margin="0,0,0,16"/>

                                    <!-- Agregar dinero -->
                                    <TextBlock Text="Agregar dinero:"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding MontoAgregar, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Monto ($)"/>
                                        <Button Grid.Column="2"
                                                Content="+ Agregar"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding AgregarDineroCommand}"/>
                                    </Grid>

                                    <!-- Eliminar -->
                                    <Button Content="Eliminar meta"
                                            Style="{StaticResource DangerButton}"
                                            Command="{Binding EliminarCommand}"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
