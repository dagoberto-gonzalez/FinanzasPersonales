<UserControl x:Class="FinanzasPersonales.Views.GastosFijosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">

            <TextBlock Text="Gastos Fijos" FontSize="26" FontWeight="Bold" Margin="0,0,0,6"/>
            <!-- Navegación entre meses: antes la pantalla estaba clavada al mes actual. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Button Content="‹" ToolTip="Mes anterior"
                        Style="{StaticResource SecondaryButton}" Padding="10,2"
                        Command="{Binding MesAnteriorCommand}"/>
                <TextBlock Text="{Binding MesAnioTexto}" MinWidth="200" TextAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                           VerticalAlignment="Center" Margin="12,0"/>
                <Button Content="›" ToolTip="Mes siguiente"
                        Style="{StaticResource SecondaryButton}" Padding="10,2"
                        Command="{Binding MesSiguienteCommand}"/>
                <Button Content="Volver al mes actual"
                        Style="{StaticResource SecondaryButton}" Padding="12,2" Margin="12,0,0,0"
                        Command="{Binding MesActualCommand}"
                        Visibility="{Binding VolverAlActualVisibility}"/>
            </StackPanel>

            <!-- Tarjetas resumen -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PENDIENTE" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalPendienteTexto}"
                                   Foreground="{DynamicResource RedBrush}"
                                   FontSize="26" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PAGADO" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalPagadoTexto}"
                                   Foreground="{DynamicResource GreenBrush}"
                                   FontSize="26" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Formulario nuevo gasto fijo -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{Binding TituloFormulario}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <!-- Editar no reescribe lo ya pagado: cada pago es una transacción propia. -->
                    <TextBlock Text="Los cambios valen desde el próximo pago. Lo ya pagado se corrige en Transacciones."
                               Foreground="{DynamicResource YellowBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,4"
                               Visibility="{Binding EditandoVisibility}"/>
                    <TextBlock Text="El pago de una tarjeta de crédito no va aquí: se registra en la pantalla Tarjetas, donde se descuenta del saldo pendiente. Lo que compraste con la tarjeta ya cuenta como gasto en el mes de la compra."
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Nombre del gasto"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding Monto, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="₡ Monto"/>
                        <TextBox Grid.Column="4"
                                 Text="{Binding DiaVencimiento, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Día 1"/>
                        <TextBox Grid.Column="6"
                                 Text="{Binding DiaVencimiento2, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Día 2 (opc.)"/>
                        <Button Grid.Column="8"
                                Content="{Binding TextoGuardar}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding GuardarCommand}"
                                Padding="18,10"/>
                        <Button Grid.Column="9"
                                Content="Cancelar"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelarEdicionCommand}"
                                Padding="14,10" Margin="8,0,0,0"
                                Visibility="{Binding EditandoVisibility}"/>
                    </Grid>

                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource RedBrush}"
                               FontSize="12" Margin="0,10,0,0"
                               Visibility="{Binding MensajeErrorVisibility}"/>
                </StackPanel>
            </Border>

            <!-- Lista de gastos fijos (agrupada por día de vencimiento) -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Gastos fijos del mes" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Grupos por día -->
                    <ItemsControl ItemsSource="{Binding GruposGastos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16">

                                    <!-- Encabezado del grupo -->
                                    <TextBlock Text="{Binding Titulo}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,0,0,8"/>

                                    <!-- Ítems del grupo -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" CornerRadius="8" Padding="14,10">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EsVencido}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource RedRowBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding EsUrgente}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource YellowRowBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PagadoEsteMes}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource GreenRowBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="16"/>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- CheckBox pagado -->
                                                        <CheckBox Grid.Column="0"
                                                                  IsChecked="{Binding PagadoEsteMes, Mode=OneWay}"
                                                                  Margin="0,0,12,0"
                                                                  VerticalAlignment="Center"
                                                                  Command="{Binding DataContext.TogglePagoCommand,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"/>

                                                        <!-- Info -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="13"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Foreground="{DynamicResource YellowBrush}"
                                                                           FontSize="11">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding EsUrgente}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Setter Property="Text"
                                                                                            Value="{Binding DiasParaVencer, StringFormat='⚠ Vence en {0} días'}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="⛔ Vencido"
                                                                           Foreground="{DynamicResource RedBrush}"
                                                                           FontSize="11">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding EsVencido}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Monto -->
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Monto, StringFormat='₡{0:N0}'}"
                                                                   FontSize="15" FontWeight="Bold"
                                                                   Foreground="{DynamicResource RedBrush}"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- Método de pago (solo si no pagado) -->
                                                        <ComboBox Grid.Column="4"
                                                                  ItemsSource="{Binding DataContext.MetodosPago,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  SelectedItem="{Binding MetodoPagoSeleccionado}"
                                                                  VerticalAlignment="Center">
                                                            <ComboBox.Style>
                                                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PagadoEsteMes}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ComboBox.Style>
                                                        </ComboBox>

                                                        <!-- Estado chip -->
                                                        <Border Grid.Column="6" CornerRadius="4" Padding="8,4"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource YellowTintBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PagadoEsteMes}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource GreenTintBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="11">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="Pendiente"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource YellowBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding PagadoEsteMes}" Value="True">
                                                                                <Setter Property="Text" Value="Pagado"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <!-- Editar + Eliminar -->
                                                        <Button Grid.Column="7"
                                                                Content="✎"
                                                                ToolTip="Editar"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Padding="8,4" Margin="8,0,8,0"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding DataContext.EditarCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="8"
                                                                Content="✕"
                                                                Style="{StaticResource DangerButton}"
                                                                Padding="8,4"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding DataContext.EliminarCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No hay gastos fijos registrados."
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="13" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GruposGastos.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
