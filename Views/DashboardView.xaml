<UserControl x:Class="FinanzasPersonales.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FinanzasPersonales.Controls"
             Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">

            <!-- Banner presupuesto excedido -->
            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    Background="#F38BA822"
                    Visibility="{Binding BannerPresupuestoVisibility}">
                <TextBlock Text="{Binding PresupuestoTexto}"
                           Foreground="{StaticResource RedBrush}"
                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <!-- Banner alertas gastos urgentes -->
            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    Background="#F9E2AF"
                    BorderBrush="#E8C97A"
                    BorderThickness="1"
                    Visibility="{Binding AlertasVisibility}">
                <StackPanel>
                    <TextBlock Text="⚠ Gastos fijos próximos a vencer o vencidos:"
                               Foreground="#1C1A00"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding GastosUrgentes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Nombre}"/>
                                                <Setter Property="Foreground" Value="#1C1A00"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsVencido}" Value="True">
                                                        <Setter Property="Foreground" Value="#8B1A1A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text=" — " Foreground="#5C4E00" FontSize="12"/>
                                    <TextBlock Text="{Binding Monto, StringFormat='₡{0:N0}'}"
                                               Foreground="#5C4E00" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Banner alerta tarjetas con fecha de pago próxima (≤7 días) -->
            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    Background="#F9E2AF"
                    BorderBrush="#E8C97A"
                    BorderThickness="1"
                    Visibility="{Binding AlertasTarjetasVisibility}">
                <StackPanel>
                    <TextBlock Text="&#x1F4B3; Tarjetas con fecha de pago próxima:"
                               Foreground="#1C1A00"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding TarjetasProximasPago}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Nombre}"
                                               Foreground="#1C1A00" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text=" — límite de pago: "
                                               Foreground="#5C4E00" FontSize="12"/>
                                    <TextBlock Text="{Binding FechaLimitePagoTexto}"
                                               Foreground="#1C1A00" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text=" — "
                                               Foreground="#5C4E00" FontSize="12"/>
                                    <TextBlock Text="{Binding SaldoUsado, StringFormat='₡{0:N0} pendiente'}"
                                               Foreground="#8B1A1A" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Banner cierre de mes pendiente -->
            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    Background="{StaticResource AccentBrush}"
                    Visibility="{Binding BannerCierreMesVisibility}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding BannerCierreMesTexto}"
                               Foreground="White"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Grid.Column="2"
                            Content="Cerrar mes"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CerrarMesCommand}"
                            Padding="16,8"/>
                </Grid>
            </Border>

            <TextBlock Text="Dashboard" FontSize="26" FontWeight="Bold" Margin="0,0,0,24"/>

            <!-- Tarjetas de resumen -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="BALANCE TOTAL"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding BalanceTotalTexto}"
                                   Foreground="{Binding BalanceBrush}"
                                   FontSize="28" FontWeight="Bold" Margin="0,8,0,4"/>
                        <TextBlock Text="Saldo acumulado"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="INGRESOS DEL MES"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding IngresosMesTexto}"
                                   Foreground="{StaticResource GreenBrush}"
                                   FontSize="28" FontWeight="Bold" Margin="0,8,0,4"/>
                        <TextBlock Text="&#x2191; Entradas este mes"
                                   Foreground="{StaticResource GreenBrush}" FontSize="12" Opacity="0.85"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="GASTOS DEL MES"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding GastosMesTexto}"
                                   Foreground="{StaticResource RedBrush}"
                                   FontSize="28" FontWeight="Bold" Margin="0,8,0,4"/>
                        <TextBlock Text="&#x2193; Salidas este mes"
                                   Foreground="{StaticResource RedBrush}" FontSize="12" Opacity="0.85"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Segunda fila: gráfica + recientes -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Gastos por categoría — mes actual"
                                   FontSize="15" FontWeight="SemiBold" Margin="0,0,0,20"/>
                        <controls:PieChartControl Slices="{Binding GastosSeries}" Height="210"/>

                        <!-- Gráfica de barras: Ingresos vs Gastos del mes -->
                        <TextBlock Text="Ingresos vs Gastos — mes actual"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,24,0,12"/>
                        <controls:BarChartControl Items="{Binding BarrasMes}" Height="160"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Últimas transacciones"
                                   FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <ItemsControl ItemsSource="{Binding UltimasTransacciones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding EtiquetaDisplay}"
                                                           FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Categoria}"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Monto, StringFormat='₡{0:N0}'}"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tipo}" Value="Gasto">
                                                                    <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Fecha, StringFormat='dd/MM/yyyy'}"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No hay transacciones registradas aún."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="13" Margin="0,12,0,0"
                                   Visibility="{Binding SinTransaccionesVisibility}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Saldo por cuenta -->
            <TextBlock Text="Saldo por cuenta"
                       FontSize="15" FontWeight="SemiBold" Margin="0,24,0,12" Foreground="White">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CuentasSaldo.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding CuentasSaldo}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CuentasSaldo.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Nombre}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding Tipo}"
                                           Foreground="White"
                                           FontSize="11" Margin="0,2,0,8"/>
                                <TextBlock Text="{Binding SaldoDisplay}"
                                           Foreground="{Binding SaldoBrush}"
                                           FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
