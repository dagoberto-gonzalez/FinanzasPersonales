<UserControl x:Class="FinanzasPersonales.Views.CategoriasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28" MaxWidth="700">

            <TextBlock Text="Categorías" FontSize="26" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock Text="Gestiona las categorías para clasificar tus transacciones."
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,0,0,24"/>

            <!-- Agregar categoría -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Nueva categoría" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding NuevaCategoria, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Nombre de la categoría"/>
                        <!-- En Transacciones sólo se ofrece para este tipo de movimiento. -->
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding Tipos}"
                                  SelectedItem="{Binding NuevaTipo}"
                                  ToolTip="Para qué movimientos se ofrece en Transacciones"/>
                        <Button Grid.Column="4"
                                Content="Agregar"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding AgregarCommand}"
                                Padding="20,10"/>
                    </Grid>
                    <!-- Checkbox "Global" solo para admin -->
                    <CheckBox Content="Categoría global (visible para todos los usuarios)"
                              IsChecked="{Binding NuevaEsGlobal}"
                              Foreground="{DynamicResource TextMutedBrush}"
                              FontSize="12" Margin="0,10,0,0"
                              Visibility="{Binding CheckGlobalVisibility}"/>
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{DynamicResource RedBrush}"
                               FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding MensajeErrorVisibility}"/>
                </StackPanel>
            </Border>

            <!-- Lista de categorías -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Categorías existentes" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

                    <ItemsControl ItemsSource="{Binding Categorias}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                                    <StackPanel>

                                        <!-- ── Fila normal ── -->
                                        <Grid Visibility="{Binding VistaVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Badge "Global" -->
                                            <Border Grid.Column="0" CornerRadius="4" Padding="6,2"
                                                    Background="{DynamicResource BorderBrush}" Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EsGlobal}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="GLOBAL" FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentLightBrush}"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nombre}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TipoTexto}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="11" Margin="10,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Las de sistema, y las globales para un usuario
                                                 normal, no ofrecen acciones: antes mostraban
                                                 botones que sólo servían para dar un error. -->
                                            <Button Grid.Column="2"
                                                    Content="Editar"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="12,4"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding AccionesVisibility}"
                                                    Command="{Binding EditarCommand}"/>

                                            <Button Grid.Column="4"
                                                    Content="✕"
                                                    Style="{StaticResource DangerButton}"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding AccionesVisibility}"
                                                    Command="{Binding EliminarCommand}"/>
                                        </Grid>

                                        <!-- ── La misma fila, en edición ── -->
                                        <StackPanel Visibility="{Binding EdicionVisibility}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBox Grid.Column="0"
                                                         Text="{Binding NombreEditado, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="Nuevo nombre"
                                                         VerticalAlignment="Center"/>

                                                <ComboBox Grid.Column="2"
                                                          ItemsSource="{Binding Tipos}"
                                                          SelectedItem="{Binding TipoEditado}"
                                                          VerticalAlignment="Center"/>

                                                <Button Grid.Column="4"
                                                        Content="Guardar"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Padding="16,6"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding GuardarCommand}"/>

                                                <Button Grid.Column="6"
                                                        Content="Cancelar"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="14,6"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding CancelarCommand}"/>
                                            </Grid>

                                            <TextBlock Text="{Binding MensajeError}"
                                                       Foreground="{DynamicResource RedBrush}"
                                                       FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding MensajeErrorVisibility}"/>
                                        </StackPanel>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No hay categorías registradas."
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="13" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Categorias.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Avisos de altas y bajas; los de edición salen dentro de su propia fila -->
            <TextBlock Text="{Binding MensajeOk}"
                       Foreground="{DynamicResource GreenBrush}"
                       FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"
                       Visibility="{Binding MensajeOkVisibility}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
