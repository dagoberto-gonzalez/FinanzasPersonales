<UserControl x:Class="FinanzasPersonales.Views.CategoriasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28" MaxWidth="700">

            <TextBlock Text="Categorías" FontSize="26" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock Text="Gestiona las categorías para clasificar tus transacciones."
                       Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,0,0,24"/>

            <!-- Agregar categoría -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Nueva categoría" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding NuevaCategoria, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Nombre de la categoría"/>
                        <Button Grid.Column="2"
                                Content="Agregar"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding AgregarCommand}"
                                Padding="20,10"/>
                    </Grid>
                    <!-- Checkbox "Global" solo para admin -->
                    <CheckBox Content="Categoría global (visible para todos los usuarios)"
                              IsChecked="{Binding NuevaEsGlobal}"
                              Foreground="{StaticResource TextMutedBrush}"
                              FontSize="12" Margin="0,10,0,0"
                              Visibility="{Binding CheckGlobalVisibility}"/>
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{StaticResource RedBrush}"
                               FontSize="12" Margin="0,10,0,0"
                               Visibility="{Binding MensajeErrorVisibility}"/>
                </StackPanel>
            </Border>

            <!-- Lista de categorías -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Categorías existentes" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

                    <ItemsControl ItemsSource="{Binding Categorias}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2A2D3E" CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Badge "Global" -->
                                        <Border Grid.Column="0" CornerRadius="4" Padding="6,2"
                                                Background="#3A3D52" Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsGlobal}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="GLOBAL" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentLightBrush}"/>
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Nombre}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Column="2"
                                                Content="Editar"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="12,4"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.SeleccionarCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>

                                        <Button Grid.Column="4"
                                                Content="✕"
                                                Style="{StaticResource DangerButton}"
                                                Padding="8,4"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.EliminarCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No hay categorías registradas."
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="13" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Categorias.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Panel de edición inline -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0"
                    Visibility="{Binding PuedeEditar, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12">
                        <Run Text="Editar: "/>
                        <Run Text="{Binding Seleccionada.Nombre}" Foreground="{StaticResource AccentBrush}"/>
                    </TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding EditNombre, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Nuevo nombre"/>
                        <Button Grid.Column="2"
                                Content="Guardar"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding GuardarEditCommand}"
                                Padding="20,10"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
