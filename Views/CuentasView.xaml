<UserControl x:Class="FinanzasPersonales.Views.CuentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">

            <TextBlock Text="Cuentas" FontSize="26" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock Text="Registra tus cuentas bancarias y métodos de pago."
                       Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,0,0,24"/>

            <!-- ── Formulario nueva cuenta ────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Agregar nueva cuenta"
                               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nombre" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding NuevaNombre, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Ej. BAC Débito, Banco Nacional"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tipo" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Tipos}"
                                      SelectedItem="{Binding NuevoTipo}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Banco (opcional)" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding NuevoBanco, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Ej. BAC San José"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Saldo inicial" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding NuevoSaldoInicial, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="₡ 0"/>
                        </StackPanel>

                        <Button Grid.Column="8"
                                Content="Agregar"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding AgregarCommand}"
                                VerticalAlignment="Bottom"
                                Padding="20,11"/>
                    </Grid>

                    <TextBlock Text="{Binding NuevaError}"
                               Foreground="{StaticResource RedBrush}"
                               FontSize="12" Margin="0,10,0,0"
                               Visibility="{Binding NuevaErrorVisibility}"/>
                </StackPanel>
            </Border>

            <!-- ── Transferir entre cuentas ──────────────────────────────────────
                 Dos movimientos enlazados: no cuentan como gasto ni como ingreso. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Transferir entre cuentas"
                               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Mueve dinero de una cuenta a otra, o entre una cuenta y el efectivo. No cuenta como gasto ni como ingreso."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Desde" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding OpcionesTransferencia}"
                                      SelectedItem="{Binding TransOrigen}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hacia" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding OpcionesTransferencia}"
                                      SelectedItem="{Binding TransDestino}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Monto" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding TransMonto, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="₡ 0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Fecha" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding TransFecha}" FirstDayOfWeek="Monday"/>
                        </StackPanel>
                        <StackPanel Grid.Column="8">
                            <TextBlock Text="Nota (opcional)" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding TransNota, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Ej. ahorro del mes"/>
                        </StackPanel>
                        <Button Grid.Column="10"
                                Content="Transferir"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding TransferirCommand}"
                                VerticalAlignment="Bottom"
                                Padding="20,11"/>
                    </Grid>

                    <TextBlock Text="{Binding TransError}"
                               Foreground="{StaticResource RedBrush}"
                               FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding TransErrorVisibility}"/>
                    <TextBlock Text="{Binding TransOk}"
                               Foreground="{StaticResource GreenBrush}"
                               FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding TransOkVisibility}"/>
                </StackPanel>
            </Border>

            <!-- ── Lista + edición ───────────────────────────────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tabla de cuentas -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <DataGrid ItemsSource="{Binding Cuentas}"
                              SelectedItem="{Binding Seleccionada}"
                              SelectionMode="Single"
                              Margin="0">
                        <!-- Reemplaza el RowStyle general de App.xaml (por eso repite sus dos
                             triggers) para añadir la fila Efectivo: no es una cuenta guardada,
                             así que no se puede seleccionar ni editar. -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2D2D4A"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2D1F5E"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding EsEfectivo}" Value="True">
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                        <Setter Property="Focusable"        Value="False"/>
                                        <Setter Property="FontStyle"        Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="NOMBRE"
                                                Binding="{Binding Nombre}"
                                                Width="*" MinWidth="120"/>

                            <DataGridTextColumn Header="TIPO"
                                                Binding="{Binding Tipo}"
                                                Width="140"/>

                            <DataGridTextColumn Header="BANCO"
                                                Binding="{Binding BancoDisplay}"
                                                Width="80"/>

                            <DataGridTemplateColumn Header="SALDO" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SaldoDisplay}"
                                                   Foreground="{Binding SaldoBrush}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- D5: lo reservado en metas sigue en la cuenta; LIBRE es lo que no tiene destino. -->
                            <DataGridTextColumn Header="EN METAS"
                                                Binding="{Binding ApartadoDisplay}"
                                                Width="85"/>
                            <DataGridTextColumn Header="LIBRE"
                                                Binding="{Binding LibreDisplay}"
                                                Width="105"/>

                            <DataGridTemplateColumn Header="ESTADO" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2"
                                                HorizontalAlignment="Left" Margin="0,4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1A3B2A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Activa}" Value="False">
                                                            <Setter Property="Background" Value="#3A3A4A"/>
                                                        </DataTrigger>
                                                        <!-- El efectivo no se activa ni desactiva. -->
                                                        <DataTrigger Binding="{Binding EsEfectivo}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding EstadoTexto}"
                                                       FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Activa}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Panel edición (visible al seleccionar) -->
                <!-- Columnas Auto: oculto, el panel no reserva espacio y la tabla usa todo el ancho. -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Width="320" Margin="16,0,0,0"
                        Visibility="{Binding HaySeleccion, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Editar cuenta"
                                   FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <TextBlock Text="Nombre" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding EditNombre, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Tipo" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Tipos}"
                                  SelectedItem="{Binding EditTipo}"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="Banco (opcional)" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding EditBanco, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Opcional"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Saldo inicial" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding EditSaldoInicial, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="₡ 0"
                                 Margin="0,0,0,4"/>
                        <TextBlock Text="El saldo mostrado es este valor más las transacciones. Ajústalo si la cuenta no cuadra con el banco."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <CheckBox Content="Cuenta activa"
                                  IsChecked="{Binding EditActiva}"
                                  Margin="0,0,0,20"/>

                        <TextBlock Text="{Binding MensajeError}"
                                   Foreground="{StaticResource RedBrush}"
                                   FontSize="12" Margin="0,0,0,8"
                                   Visibility="{Binding MensajeErrorVisibility}"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding MensajeOk}"
                                   Foreground="{StaticResource GreenBrush}"
                                   FontSize="12" Margin="0,0,0,8"
                                   Visibility="{Binding MensajeOkVisibility}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Guardar cambios"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding GuardarCambiosCommand}"
                                    Padding="0,10"/>
                            <Button Grid.Column="2"
                                    Content="Eliminar"
                                    Style="{StaticResource DangerButton}"
                                    Command="{Binding EliminarCommand}"
                                    Padding="14,10"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
