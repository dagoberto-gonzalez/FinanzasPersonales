<UserControl x:Class="FinanzasPersonales.Views.IngresosFijosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">

            <TextBlock Text="Ingresos Fijos" FontSize="26" FontWeight="Bold" Margin="0,0,0,6"/>
            <!-- Navegación entre meses: antes la pantalla estaba clavada al mes actual. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Button Content="‹" ToolTip="Mes anterior"
                        Style="{StaticResource SecondaryButton}" Padding="10,2"
                        Command="{Binding MesAnteriorCommand}"/>
                <TextBlock Text="{Binding MesAnioTexto}" MinWidth="200" TextAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                           VerticalAlignment="Center" Margin="12,0"/>
                <Button Content="›" ToolTip="Mes siguiente"
                        Style="{StaticResource SecondaryButton}" Padding="10,2"
                        Command="{Binding MesSiguienteCommand}"/>
                <Button Content="Volver al mes actual"
                        Style="{StaticResource SecondaryButton}" Padding="12,2" Margin="12,0,0,0"
                        Command="{Binding MesActualCommand}"
                        Visibility="{Binding VolverAlActualVisibility}"/>
            </StackPanel>

            <!-- Tarjetas resumen -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="POR RECIBIR" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalPendienteTexto}"
                                   Foreground="{StaticResource YellowBrush}"
                                   FontSize="26" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="RECIBIDO" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalRecibidoTexto}"
                                   Foreground="{StaticResource GreenBrush}"
                                   FontSize="26" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Formulario nuevo ingreso fijo -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{Binding TituloFormulario}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <!-- Editar no reescribe lo ya recibido: cada cobro es una transacción propia. -->
                    <TextBlock Text="Los cambios valen desde el próximo cobro. Lo ya recibido se corrige en Transacciones."
                               Foreground="{StaticResource YellowBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,-12,0,12"
                               Visibility="{Binding EditandoVisibility}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Nombre del ingreso"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding Monto, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="₡ Monto"/>
                        <TextBox Grid.Column="4"
                                 Text="{Binding DiaIngreso, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Día 1"/>
                        <TextBox Grid.Column="6"
                                 Text="{Binding DiaIngreso2, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Día 2 (opc.)"/>
                        <ComboBox Grid.Column="8"
                                  ItemsSource="{Binding CuentasDisponibles}"
                                  SelectedItem="{Binding CuentaSeleccionada}"
                                  DisplayMemberPath="Nombre"
                                  Tag="Cuenta (opc.)"/>
                        <Button Grid.Column="10"
                                Content="{Binding TextoGuardar}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding GuardarCommand}"
                                Padding="18,10"/>
                        <Button Grid.Column="11"
                                Content="Cancelar"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelarEdicionCommand}"
                                Padding="14,10" Margin="8,0,0,0"
                                Visibility="{Binding EditandoVisibility}"/>
                    </Grid>

                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{StaticResource RedBrush}"
                               FontSize="12" Margin="0,10,0,0"
                               Visibility="{Binding MensajeErrorVisibility}"/>
                </StackPanel>
            </Border>

            <!-- Lista de ingresos fijos (agrupada por día de cobro) -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Ingresos fijos del mes" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Grupos por día -->
                    <ItemsControl ItemsSource="{Binding GruposIngresos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16">

                                    <!-- Encabezado del grupo -->
                                    <TextBlock Text="{Binding Titulo}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource GreenBrush}"
                                               Margin="0,0,0,8"/>

                                    <!-- Ítems del grupo -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" CornerRadius="8" Padding="14,10">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#2A2D3E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RecibidoEsteMes}" Value="True">
                                                                    <Setter Property="Background" Value="#1A2A1E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- CheckBox recibido -->
                                                        <CheckBox Grid.Column="0"
                                                                  IsChecked="{Binding RecibidoEsteMes, Mode=OneWay}"
                                                                  Margin="0,0,12,0"
                                                                  VerticalAlignment="Center"
                                                                  Command="{Binding DataContext.ToggleRecibidoCommand,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"/>

                                                        <!-- Info -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="13"/>
                                                        </StackPanel>

                                                        <!-- Monto -->
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Monto, StringFormat='₡{0:N0}'}"
                                                                   FontSize="15" FontWeight="Bold"
                                                                   Foreground="{StaticResource GreenBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,16,0"/>

                                                        <!-- Estado chip -->
                                                        <Border Grid.Column="3" CornerRadius="4" Padding="8,4" Margin="0,0,12,0"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#F9E2AF22"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RecibidoEsteMes}" Value="True">
                                                                            <Setter Property="Background" Value="#A6E3A122"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="11">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="Pendiente"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource YellowBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RecibidoEsteMes}" Value="True">
                                                                                <Setter Property="Text" Value="Recibido"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <!-- Editar -->
                                                        <Button Grid.Column="4"
                                                                Content="✎"
                                                                ToolTip="Editar"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Padding="8,4" Margin="0,0,8,0"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding DataContext.EditarCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>

                                                        <!-- Eliminar -->
                                                        <Button Grid.Column="5"
                                                                Content="✕"
                                                                Style="{StaticResource DangerButton}"
                                                                Padding="8,4"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding DataContext.EliminarCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No hay ingresos fijos registrados."
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="13" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GruposIngresos.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
