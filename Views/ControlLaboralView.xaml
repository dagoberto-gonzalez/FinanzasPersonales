<UserControl x:Class="FinanzasPersonales.Views.ControlLaboralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">

            <!-- Alerta día de pago -->
            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,14"
                    Background="{StaticResource AccentBrush}"
                    Visibility="{Binding AlertaPagoVisibility}">
                <TextBlock Text="{Binding AlertaPagoTexto}"
                           Foreground="White"
                           FontSize="13" FontWeight="SemiBold"/>
            </Border>

            <TextBlock Text="Control Laboral" FontSize="26" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock Text="Registra tus horas, calcula tu salario y gestiona deducciones según la ley costarricense."
                       Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,0,0,24"/>

            <!-- ── Configuración ──────────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Configuración" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

                    <!-- Fila 1: Salario / Jornada / Modo -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Salario por hora (₡)"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ConfigSalarioXHora, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Ej. 3500"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Jornada semanal (horas)"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ConfigJornada, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="48"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Modo de pago"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding ModosPago}"
                                      SelectedItem="{Binding ConfigModoPago}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Fila 2: fechas de pago + viáticos -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mensual: un día -->
                        <StackPanel Grid.Column="0"
                                    Visibility="{Binding MensualVisibility}">
                            <TextBlock Text="Día de pago (1–31)"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ConfigDiaPago, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="15"/>
                        </StackPanel>

                        <!-- Quincenal: dos días -->
                        <StackPanel Grid.Column="0"
                                    Visibility="{Binding QuincenalVisibility}">
                            <TextBlock Text="Primer día de pago"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ConfigDiaPago, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="15"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Visibility="{Binding QuincenalVisibility}">
                            <TextBlock Text="Segundo día de pago"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ConfigDiaPago2, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="30"/>
                        </StackPanel>

                        <!-- Semanal: día de la semana -->
                        <StackPanel Grid.Column="0"
                                    Visibility="{Binding SemanalVisibility}">
                            <TextBlock Text="Día de pago semanal"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding DiasSemana}"
                                      SelectedItem="{Binding ConfigDiaSemana}"/>
                        </StackPanel>

                        <!-- Viáticos por período (siempre visible) -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Viáticos por período (₡)"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ConfigViaticos, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="0"/>
                        </StackPanel>

                        <!-- Botón siempre visible -->
                        <Button Grid.Column="6"
                                Content="Guardar"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding GuardarConfigCommand}"
                                VerticalAlignment="Bottom"
                                Padding="20,11"/>
                    </Grid>

                    <TextBlock Text="{Binding ConfigMensaje}"
                               Foreground="{Binding ConfigMensajeColor}"
                               FontSize="12" Margin="0,4,0,0"
                               Visibility="{Binding ConfigMensajeVisibility}"/>
                </StackPanel>
            </Border>

            <!-- ── Segunda fila: Registro + Resumen ─────────────────────────── -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Registro del período -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14">
                            <Run Text="Registro — "/>
                            <Run Text="{Binding PeriodoActualLabel, Mode=OneWay}"/>
                        </TextBlock>

                        <!-- Formulario agregar -->
                        <Border Background="{StaticResource SurfaceBrush}"
                                CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Agregar / actualizar día"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Fecha" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding RegFecha, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="dd/MM/yyyy" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="H. Extra Diur." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding RegHorasExtraDiurnas, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="0" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="H. Extra Noct." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding RegHorasExtraNocturnas, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="0" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="H. Dobles" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding RegHorasDobles, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="0" FontSize="12"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Checkboxes -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                                    <CheckBox Content="Feriado (200%)" IsChecked="{Binding RegEsFeriado}"
                                              Foreground="{StaticResource TextBrush}" Margin="0,0,20,0"/>
                                    <CheckBox Content="Ausencia" IsChecked="{Binding RegEsAusencia}"
                                              Foreground="{StaticResource TextBrush}" Margin="0,0,20,0"/>
                                    <CheckBox Content="Con goce de salario" IsChecked="{Binding RegTieneGoce}"
                                              Foreground="{StaticResource GreenBrush}"
                                              Visibility="{Binding GoceVisibility}"/>
                                </StackPanel>

                                <TextBlock Text="{Binding RegError}"
                                           Foreground="{StaticResource RedBrush}"
                                           FontSize="11" Margin="0,0,0,8"
                                           Visibility="{Binding RegErrorVisibility}"/>

                                <Button Content="Registrar día"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding AgregarRegistroCommand}"
                                        HorizontalAlignment="Left"
                                        Padding="20,9"/>
                            </StackPanel>
                        </Border>

                        <!-- Tabla de registros -->
                        <DataGrid ItemsSource="{Binding Registros}"
                                  SelectedItem="{Binding Seleccionado}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MaxHeight="320"
                                  ColumnHeaderHeight="34"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha"
                                                    Binding="{Binding FechaDisplay}"
                                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="Padding" Value="6,0"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Tipo"
                                                    Binding="{Binding TipoDisplay}"
                                                    Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="Padding" Value="6,0"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="H. Extra D."
                                                    Binding="{Binding HorasExtraDiurnas, StringFormat='{}{0:N1}'}"
                                                    Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="6,0"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="H. Extra N."
                                                    Binding="{Binding HorasExtraNocturnas, StringFormat='{}{0:N1}'}"
                                                    Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="6,0"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="H. Dobles"
                                                    Binding="{Binding HorasDobles, StringFormat='{}{0:N1}'}"
                                                    Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="6,0"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Total H."
                                                    Binding="{Binding TotalHoras, StringFormat='{}{0:N1}'}"
                                                    Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="6,0"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="" Width="52" MinWidth="52">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕"
                                                    Style="{StaticResource DangerButton}"
                                                    Width="36" Height="26"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.EliminarRegistroCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Resumen del período -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Resumen" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <!-- Salario base estimado -->
                        <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,14"
                                Background="{StaticResource SurfaceBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Base estimada (período completo)"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ResumenSalarioBase}"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource AccentLightBrush}"/>
                            </Grid>
                        </Border>

                        <!-- Variaciones -->
                        <TextBlock Text="VARIACIONES" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Extra diurnas (+50%)" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenExtraD}" FontSize="12"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Extra nocturnas (+75%)" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenExtraN}" FontSize="12"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Dobles (+100%)" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenDobles}" FontSize="12"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Feriados trabajados" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenFeriados}" FontSize="12"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Viáticos del período" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenViaticos}" FontSize="12"
                                       Foreground="{StaticResource GreenBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Ausencias sin goce (desc.)" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenDescAusencias}" FontSize="12"
                                       Foreground="{StaticResource RedBrush}"/>
                        </Grid>

                        <!-- Salario -->
                        <TextBlock Text="SALARIO" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Salario bruto" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenSalarioBruto}" FontSize="12" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="CCSS obrero" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenDeduccionCCSS}" FontSize="12"
                                       Foreground="{StaticResource RedBrush}"/>
                        </Grid>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,8"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="SALARIO NETO" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenSalarioNeto}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource GreenBrush}"/>
                        </Grid>

                        <!-- Beneficios estimados -->
                        <TextBlock Text="BENEFICIOS EST." Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Aguinaldo" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenAguinaldo}"
                                       FontSize="11" Foreground="{StaticResource AccentLightBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Vacaciones" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenVacaciones}"
                                       FontSize="11" Foreground="{StaticResource AccentLightBrush}"/>
                        </Grid>

                        <!-- Período cerrado -->
                        <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                                Background="#A6E3A122"
                                Visibility="{Binding PeriodoCerradoVisibility}">
                            <TextBlock Text="{Binding PeriodoCerradoTexto}"
                                       Foreground="{StaticResource GreenBrush}"
                                       FontSize="11" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Acciones -->
                        <StackPanel Visibility="{Binding PeriodoAbiertVisibility}" Margin="0,0,0,8">
                            <Button Content="Registrar ingreso"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="BtnRegistrarIngreso_Click"
                                    HorizontalAlignment="Stretch"
                                    Padding="12,9" Margin="0,0,0,8"/>
                            <Button Content="Cerrar período"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding CerrarPeriodoCommand}"
                                    HorizontalAlignment="Stretch"
                                    Padding="12,9"/>
                        </StackPanel>

                        <Button Content="Exportar PDF"
                                Style="{StaticResource NavButton}"
                                Command="{Binding ExportarPdfCommand}"
                                Padding="12,8"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Historial ─────────────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}">
                <StackPanel>

                    <!-- Encabezado -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Historial de ingresos" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Total año: "
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding HistorialTotalAnio}"
                                       Foreground="{StaticResource GreenBrush}"
                                       FontSize="13" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- ── Formulario: Editar cierre ─────────────────────────────── -->
                    <Border CornerRadius="8" Padding="16,14" Margin="0,0,0,16"
                            Background="{StaticResource SurfaceBrush}"
                            Visibility="{Binding EditFormVisibility}">
                        <StackPanel>
                            <TextBlock Text="{Binding EditTituloLabel}" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Salario bruto"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditBruto, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Deducciones CCSS"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditDeducciones, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Salario neto"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditNeto, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="0"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Notas (opcional)"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditNotas, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Observaciones…" Width="400" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <TextBlock Text="{Binding EditError}"
                                       Foreground="{StaticResource RedBrush}"
                                       FontSize="12" Margin="0,0,0,8"
                                       Visibility="{Binding EditErrorVisibility}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Guardar cambios"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding GuardarEdicionCommand}"
                                        Padding="12,8" Margin="0,0,10,0"/>
                                <Button Content="Cancelar"
                                        Style="{StaticResource NavButton}"
                                        Command="{Binding CancelarEdicionCommand}"
                                        Padding="12,8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Lista vacía -->
                    <TextBlock Text="No hay ingresos registrados aún."
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="13" Visibility="{Binding SinHistorialVisibility}"/>

                    <!-- DataGrid del historial -->
                    <DataGrid ItemsSource="{Binding Historial}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MaxHeight="340"
                              Visibility="{Binding ConHistorialVisibility}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha / Período" Binding="{Binding Label}"      Width="*"/>
                            <DataGridTextColumn Header="Tipo"            Binding="{Binding TipoDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Bruto"           Binding="{Binding BrutoDisplay}" Width="115"/>
                            <DataGridTextColumn Header="Deducciones"     Binding="{Binding DeduccionesDisplay}" Width="115"/>
                            <DataGridTextColumn Header="Neto / Monto"    Binding="{Binding MontoDisplay}" Width="115"/>
                            <DataGridTextColumn Header="Acumulado"       Binding="{Binding BalanceDisplay}" Width="115"/>
                            <DataGridTemplateColumn Header="Acciones" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Editar: solo para cierres de período -->
                                            <Button Content="Editar"
                                                    FontSize="11" Padding="6,3" Margin="0,0,6,0"
                                                    Style="{StaticResource NavButton}"
                                                    Command="{Binding DataContext.EditarCierreCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding EsCierre,
                                                                 Converter={StaticResource BoolToVis}}"/>
                                            <!-- Eliminar: para todos -->
                                            <Button Content="Eliminar"
                                                    FontSize="11" Padding="6,3"
                                                    Foreground="{StaticResource RedBrush}"
                                                    Style="{StaticResource NavButton}"
                                                    Command="{Binding DataContext.EliminarHistorialItemCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
