<UserControl x:Class="FinanzasPersonales.Views.ControlLaboralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">

            <!-- Alerta día de pago -->
            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,14"
                    Background="{DynamicResource AccentBrush}"
                    Visibility="{Binding AlertaPagoVisibility}">
                <TextBlock Text="{Binding AlertaPagoTexto}"
                           Foreground="White"
                           FontSize="13" FontWeight="SemiBold"/>
            </Border>

            <TextBlock Text="Control Laboral" FontSize="26" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock Text="Registra tus horas, calcula tu salario y gestiona deducciones según la ley costarricense."
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,0,0,24"/>

            <!-- ── Configuración ──────────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Configuración" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

                    <!-- Fila 1: Salario / Jornada / Modo -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <!-- Mensual y no por hora: la planilla paga medio mensual por quincena
                                 y valora la hora como mensual ÷ 240. -->
                            <TextBlock Text="Salario mensual (₡)"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ConfigSalarioMensual, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Salario fijo × 2"/>
                            <TextBlock Text="{Binding ValorHoraTexto}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Jornada semanal (horas)"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ConfigJornada, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="48"/>
                            <!-- Los días que se trabajan estaban clavados en 6 dentro del cálculo:
                                 con semana de 5 la hora diaria salía un 20 % baja, y con ella
                                 el valor de cada feriado y de cada ausencia. -->
                            <TextBlock Text="Días que trabajás por semana"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,12,0,5"/>
                            <TextBox Text="{Binding ConfigDiasPorSemana, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="5"/>
                            <TextBlock Text="{Binding HorasDiariasTexto}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Modo de pago"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding ModosPago}"
                                      SelectedItem="{Binding ConfigModoPago}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Fila 2: fechas de pago + viáticos -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mensual: un día -->
                        <StackPanel Grid.Column="0"
                                    Visibility="{Binding MensualVisibility}">
                            <TextBlock Text="Día de pago (1–31)"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ConfigDiaPago, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="15"/>
                        </StackPanel>

                        <!-- Quincenal: dos días -->
                        <StackPanel Grid.Column="0"
                                    Visibility="{Binding QuincenalVisibility}">
                            <TextBlock Text="Primer día de pago"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ConfigDiaPago, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="15"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Visibility="{Binding QuincenalVisibility}">
                            <TextBlock Text="Segundo día de pago"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ConfigDiaPago2, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="30"/>
                        </StackPanel>

                        <!-- Semanal: día de la semana -->
                        <StackPanel Grid.Column="0"
                                    Visibility="{Binding SemanalVisibility}">
                            <TextBlock Text="Día de pago semanal"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding DiasSemana}"
                                      SelectedItem="{Binding ConfigDiaSemana}"/>
                        </StackPanel>

                        <!-- Viáticos por período (siempre visible) -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Viáticos por período (₡)"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ConfigViaticos, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="0"/>
                            <!-- La deducción cambia por ley y estaba escrita a mano como 10,67 %. -->
                            <TextBlock Text="Deducción sobre el bruto (%)"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,12,0,5"/>
                            <TextBox Text="{Binding ConfigPorcentaje, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="10.83"/>
                        </StackPanel>

                        <!-- Botón siempre visible -->
                        <Button Grid.Column="6"
                                Content="Guardar"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding GuardarConfigCommand}"
                                VerticalAlignment="Bottom"
                                Padding="20,11"/>
                    </Grid>

                    <TextBlock Text="{Binding ConfigMensaje}"
                               Foreground="{Binding ConfigMensajeColor}"
                               FontSize="12" Margin="0,4,0,0"
                               Visibility="{Binding ConfigMensajeVisibility}"/>
                </StackPanel>
            </Border>

            <!-- ── Segunda fila: Registro + Resumen ─────────────────────────── -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Registro del período -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <!-- Navegación entre períodos. Antes la pantalla quedaba clavada al mes
                             en que se construyó la vista, que además se cachea: no había forma
                             de consultar una quincena anterior. -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="‹"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,2" FontSize="16"
                                    VerticalAlignment="Center"
                                    ToolTip="Período anterior"
                                    Command="{Binding PeriodoAnteriorCommand}"/>

                            <TextBlock Grid.Column="1" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding PeriodoActualLabel, Mode=OneWay}"/>

                            <Button Grid.Column="2" Content="›"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,2" FontSize="16"
                                    VerticalAlignment="Center"
                                    ToolTip="Período siguiente"
                                    Command="{Binding PeriodoSiguienteCommand}"/>
                        </Grid>

                        <TextBlock Text="{Binding PeriodoRangoTexto}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                        <Button Content="Volver al período actual"
                                Style="{StaticResource SecondaryButton}"
                                Padding="12,4" FontSize="11"
                                HorizontalAlignment="Center" Margin="0,0,0,12"
                                Visibility="{Binding VolverAlActualVisibility}"
                                Command="{Binding PeriodoActualCommand}"/>

                        <!-- Formulario agregar -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Agregar / actualizar día"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Fecha" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding RegFecha, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="dd/MM/yyyy" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="H. Extra Diur." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding RegHorasExtraDiurnas, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="0" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="H. Extra Noct." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding RegHorasExtraNocturnas, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="0" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="H. Dobles" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding RegHorasDobles, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="0" FontSize="12"/>
                                    </StackPanel>

                                    <!-- Horas trabajadas en feriado, pagadas a 1× sobre el salario fijo
                                         ("Horas Normales" en la planilla). Antes era una casilla
                                         que valía siempre la jornada diaria. -->
                                    <StackPanel Grid.Column="8">
                                        <TextBlock Text="H. Feriado" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding RegHorasFeriado, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="0" FontSize="12"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Checkboxes -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                                    <CheckBox Content="Ausencia" IsChecked="{Binding RegEsAusencia}"
                                              Foreground="{DynamicResource TextBrush}" Margin="0,0,20,0"/>
                                    <CheckBox Content="Con goce de salario" IsChecked="{Binding RegTieneGoce}"
                                              Foreground="{DynamicResource GreenBrush}"
                                              Visibility="{Binding GoceVisibility}"/>
                                </StackPanel>

                                <!-- La ausencia se mide en horas: antes era día completo o nada,
                                     así que faltar tres horas no se podía registrar. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                            Visibility="{Binding GoceVisibility}">
                                    <TextBlock Text="Horas que faltaste:"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding RegHorasAusencia, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="día completo" FontSize="12" Width="110"/>
                                    <TextBlock Text="Vacío = el día entero"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>

                                <TextBlock Text="{Binding RegError}"
                                           Foreground="{DynamicResource RedBrush}"
                                           FontSize="11" Margin="0,0,0,8"
                                           Visibility="{Binding RegErrorVisibility}"/>

                                <Button Content="Registrar día"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding AgregarRegistroCommand}"
                                        HorizontalAlignment="Left"
                                        Padding="20,9"/>
                            </StackPanel>
                        </Border>

                        <!-- Tabla de registros -->
                        <DataGrid ItemsSource="{Binding Registros}"
                                  SelectedItem="{Binding Seleccionado}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MaxHeight="320"
                                  ColumnHeaderHeight="34"
                                  HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha"
                                                    Binding="{Binding FechaDisplay}"
                                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="Padding" Value="6,0"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Tipo"
                                                    Binding="{Binding TipoDisplay}"
                                                    Width="*" MinWidth="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="Padding" Value="6,0"/></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="H. Extra D."
                                                    Binding="{Binding HorasExtraDiurnas, StringFormat='{}{0:N1}'}"
                                                    Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="6,0"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="H. Extra N."
                                                    Binding="{Binding HorasExtraNocturnas, StringFormat='{}{0:N1}'}"
                                                    Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="6,0"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="H. Dobles"
                                                    Binding="{Binding HorasDobles, StringFormat='{}{0:N1}'}"
                                                    Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="6,0"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Total H."
                                                    Binding="{Binding TotalHoras, StringFormat='{}{0:N1}'}"
                                                    Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="6,0"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="" Width="52" MinWidth="52">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕"
                                                    Style="{StaticResource DangerButton}"
                                                    Width="36" Height="26"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.EliminarRegistroCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Resumen del período -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Resumen" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <!-- Salario base estimado -->
                        <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,14"
                                Background="{DynamicResource SurfaceBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Salario fijo del período"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ResumenSalarioBase}"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentLightBrush}"/>
                            </Grid>
                        </Border>

                        <!-- Variaciones -->
                        <TextBlock Text="VARIACIONES" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Extra diurnas (+50%)" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenExtraD}" FontSize="12"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Extra nocturnas (+75%)" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenExtraN}" FontSize="12"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Dobles (+100%)" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenDobles}" FontSize="12"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Feriados (horas a 1×)" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenFeriados}" FontSize="12"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Ausencias sin goce (desc.)" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenDescAusencias}" FontSize="12"
                                       Foreground="{DynamicResource RedBrush}"/>
                        </Grid>
                        <!-- No descuentan, pero sin esta fila una ausencia con goce no se veía en el resumen. -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Ausencias con goce (no desc.)" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenAusenciaGoce}" FontSize="12"/>
                        </Grid>

                        <!-- Salario -->
                        <TextBlock Text="SALARIO" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Salario bruto" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenSalarioBruto}" FontSize="12" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="CCSS obrero" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenDeduccionCCSS}" FontSize="12"
                                       Foreground="{DynamicResource RedBrush}"/>
                        </Grid>
                        <!-- Después de la C.C.S.S. y fuera del bruto, como en el comprobante: los
                             viáticos no pagan deducción. Antes se sumaban al bruto y la pagaban. -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Viáticos (sin deducción)" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenViaticos}" FontSize="12"
                                       Foreground="{DynamicResource GreenBrush}"/>
                        </Grid>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,8"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="SALARIO NETO" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenSalarioNeto}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource GreenBrush}"/>
                        </Grid>

                        <!-- Beneficios estimados -->
                        <TextBlock Text="BENEFICIOS EST." Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Aguinaldo" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenAguinaldo}"
                                       FontSize="11" Foreground="{DynamicResource AccentLightBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Vacaciones" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding ResumenVacaciones}"
                                       FontSize="11" Foreground="{DynamicResource AccentLightBrush}"/>
                        </Grid>

                        <!-- Período cerrado -->
                        <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                                Background="{DynamicResource GreenTintBrush}"
                                Visibility="{Binding PeriodoCerradoVisibility}">
                            <TextBlock Text="{Binding PeriodoCerradoTexto}"
                                       Foreground="{DynamicResource GreenBrush}"
                                       FontSize="11" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Acciones -->
                        <!-- Cobrar y cerrar son independientes: el pago llega después de cerrar. -->
                        <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                                Background="{DynamicResource AccentTintBrush}"
                                Visibility="{Binding IngresoRegistradoVisibility}">
                            <TextBlock Text="{Binding IngresoRegistradoTexto}"
                                       Foreground="{DynamicResource AccentLightBrush}"
                                       FontSize="11" TextWrapping="Wrap"/>
                        </Border>
                        <StackPanel Margin="0,0,0,8">
                            <Button Content="Registrar ingreso"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="BtnRegistrarIngreso_Click"
                                    Visibility="{Binding RegistrarIngresoVisibility}"
                                    HorizontalAlignment="Stretch"
                                    Padding="12,9" Margin="0,0,0,8"/>
                            <Button Content="Cerrar período"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding CerrarPeriodoCommand}"
                                    Visibility="{Binding PeriodoAbiertVisibility}"
                                    HorizontalAlignment="Stretch"
                                    Padding="12,9"/>
                        </StackPanel>

                        <Button Content="Exportar PDF"
                                Style="{StaticResource NavButton}"
                                Command="{Binding ExportarPdfCommand}"
                                Padding="12,8"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Historial ─────────────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}">
                <StackPanel>

                    <!-- Encabezado -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Historial de ingresos" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Total año: "
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding HistorialTotalAnio}"
                                       Foreground="{DynamicResource GreenBrush}"
                                       FontSize="13" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- ── Formulario: Comprobante de pago ──────────────────────────
                         Sustituye a "Editar cierre", que sobrescribía lo calculado con lo pagado.
                         Se copia el comprobante tal como viene y la comparación se rehace con
                         cada tecla; lo calculado no se toca. -->
                    <Border CornerRadius="8" Padding="16,14" Margin="0,0,0,16"
                            Background="{DynamicResource SurfaceBrush}"
                            Visibility="{Binding ComprobanteVisibility}">
                        <StackPanel>
                            <TextBlock Text="{Binding ComprobanteTitulo}" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Copiá las líneas del comprobante. Lo que no venga, dejalo vacío."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                       Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="360"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Lo que dice el comprobante -->
                                <Grid Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <!-- Más compactas que las del resto de la app (42 px): son
                                             nueve filas y quedaban el doble de altas que la comparación. -->
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="MinHeight" Value="30"/>
                                            <Setter Property="Padding"   Value="8,3"/>
                                            <Setter Property="FontSize"  Value="12"/>
                                            <Setter Property="Margin"    Value="0,0,0,4"/>
                                        </Style>
                                        <Style TargetType="TextBlock" x:Key="EtiquetaComp">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </Grid.Resources>

                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Cantidad" Style="{StaticResource EtiquetaComp}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Total" Style="{StaticResource EtiquetaComp}" FontSize="11" Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="1" Text="Salario fijo" Style="{StaticResource EtiquetaComp}"/>
                                    <TextBox   Grid.Row="1" Grid.Column="3" Margin="0,0,0,6" Tag="215 115,38"
                                               Text="{Binding CompSalarioFijo, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="2" Text="Horas normales (feriado)" Style="{StaticResource EtiquetaComp}"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" Tag="0"
                                               Text="{Binding CompHorasNormales, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox   Grid.Row="2" Grid.Column="3" Margin="0,0,0,6" Tag="0"
                                               Text="{Binding CompMontoNormales, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="3" Text="Horas extra" Style="{StaticResource EtiquetaComp}"/>
                                    <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" Tag="0"
                                               Text="{Binding CompHorasExtra, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox   Grid.Row="3" Grid.Column="3" Margin="0,0,0,6" Tag="0"
                                               Text="{Binding CompMontoExtra, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="4" Text="Horas nocturnas" Style="{StaticResource EtiquetaComp}"/>
                                    <TextBox   Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" Tag="0"
                                               Text="{Binding CompHorasNoct, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox   Grid.Row="4" Grid.Column="3" Margin="0,0,0,6" Tag="0"
                                               Text="{Binding CompMontoNoct, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="5" Text="Horas dobles" Style="{StaticResource EtiquetaComp}"/>
                                    <TextBox   Grid.Row="5" Grid.Column="1" Margin="0,0,0,6" Tag="0"
                                               Text="{Binding CompHorasDobles, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox   Grid.Row="5" Grid.Column="3" Margin="0,0,0,6" Tag="0"
                                               Text="{Binding CompMontoDobles, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="6" Text="Otros (rebajos en negativo)" Style="{StaticResource EtiquetaComp}"/>
                                    <TextBox   Grid.Row="6" Grid.Column="3" Margin="0,0,0,6" Tag="0"
                                               Text="{Binding CompOtros, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="7" Text="Viáticos" Style="{StaticResource EtiquetaComp}"/>
                                    <TextBox   Grid.Row="7" Grid.Column="3" Margin="0,0,0,6" Tag="0"
                                               Text="{Binding CompViaticos, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="8" Text="C.C.S.S." Style="{StaticResource EtiquetaComp}"/>
                                    <TextBox   Grid.Row="8" Grid.Column="3" Margin="0,0,0,6" Tag="0"
                                               Text="{Binding CompDeducciones, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="9" Text="Notas" Style="{StaticResource EtiquetaComp}"/>
                                    <TextBox   Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3" Tag="N.º de comprobante…"
                                               Text="{Binding CompNotas, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- La comparación -->
                                <StackPanel Grid.Column="2">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="Horas reg. → pag." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="Calculado" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="Pagado" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="4" Text="Diferencia" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Comparacion}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="TextElement.FontWeight" Value="Normal"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EsTotal}" Value="True">
                                                                    <Setter Property="TextElement.FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <TextBlock Text="{Binding Concepto}" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding HorasTexto}" FontSize="12" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding CalculadoTexto}" FontSize="12" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding PagadoTexto}" FontSize="12" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding DiferenciaTexto}" FontSize="12" HorizontalAlignment="Right">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Cuadra}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding CompError}"
                                       Foreground="{DynamicResource RedBrush}"
                                       FontSize="12" Margin="0,8,0,0"
                                       Visibility="{Binding CompErrorVisibility}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Guardar comprobante"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding GuardarComprobanteCommand}"
                                        Padding="12,8" Margin="0,0,10,0"/>
                                <Button Content="Cancelar"
                                        Style="{StaticResource NavButton}"
                                        Command="{Binding CerrarComprobanteCommand}"
                                        Padding="12,8" Margin="0,0,10,0"/>
                                <Button Content="Quitar comprobante"
                                        Style="{StaticResource NavButton}"
                                        Foreground="{DynamicResource RedBrush}"
                                        Command="{Binding BorrarComprobanteCommand}"
                                        Padding="12,8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Lista vacía -->
                    <TextBlock Text="No hay ingresos registrados aún."
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="13" Visibility="{Binding SinHistorialVisibility}"/>

                    <!-- DataGrid del historial -->
                    <DataGrid ItemsSource="{Binding Historial}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MaxHeight="340"
                              Visibility="{Binding ConHistorialVisibility}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha / Período" Binding="{Binding Label}"      Width="*" MinWidth="130"/>
                            <DataGridTextColumn Header="Bruto"           Binding="{Binding BrutoDisplay}" Width="105"/>
                            <DataGridTextColumn Header="Deducciones"     Binding="{Binding DeduccionesDisplay}" Width="105"/>
                            <DataGridTextColumn Header="Neto / Monto"    Binding="{Binding MontoDisplay}" Width="105"/>
                            <DataGridTextColumn Header="Acumulado"       Binding="{Binding BalanceDisplay}" Width="105"/>
                            <DataGridTextColumn Header="Ingreso"         Binding="{Binding Ingreso}" Width="95"/>
                            <DataGridTextColumn Header="Comprobante"     Binding="{Binding Comprobante}" Width="120"/>
                            <DataGridTemplateColumn Header="Acciones" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Comprobante: solo para cierres de período -->
                                            <Button Content="Comprobante"
                                                    FontSize="11" Padding="6,3" Margin="0,0,6,0"
                                                    Style="{StaticResource NavButton}"
                                                    Command="{Binding DataContext.AbrirComprobanteCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding EsCierre,
                                                                 Converter={StaticResource BoolToVis}}"/>
                                            <!-- Eliminar: para todos -->
                                            <Button Content="Eliminar"
                                                    FontSize="11" Padding="6,3"
                                                    Foreground="{DynamicResource RedBrush}"
                                                    Style="{StaticResource NavButton}"
                                                    Command="{Binding DataContext.EliminarHistorialItemCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
