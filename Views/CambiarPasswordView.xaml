<UserControl x:Class="FinanzasPersonales.Views.CambiarPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid>
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="420"
                Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Cambiar contraseña"
                           FontSize="20" FontWeight="Bold" Margin="0,0,0,24"/>

                <TextBlock Text="Contraseña actual"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PwdActual"
                             Height="40"
                             Margin="0,0,0,16"
                             PasswordChanged="PwdActual_Changed"/>

                <TextBlock Text="Nueva contraseña (mínimo 6 caracteres)"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PwdNuevo"
                             Height="40"
                             Margin="0,0,0,16"
                             PasswordChanged="PwdNuevo_Changed"/>

                <TextBlock Text="Confirmar nueva contraseña"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PwdConfirm"
                             Height="40"
                             Margin="0,0,0,20"
                             PasswordChanged="PwdConfirm_Changed"/>

                <!-- Mensaje -->
                <Border CornerRadius="6" Padding="12,8" Margin="0,0,0,16"
                        Visibility="{Binding MensajeVisibility}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F38BA822"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsExito}" Value="True">
                                    <Setter Property="Background" Value="#A6E3A122"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding MensajeError}"
                               TextWrapping="Wrap" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EsExito}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Button Content="Cambiar contraseña"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding CambiarCommand}"
                        Height="42" FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
