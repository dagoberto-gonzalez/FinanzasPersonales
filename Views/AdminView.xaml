<UserControl x:Class="FinanzasPersonales.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28" MaxWidth="820">

            <TextBlock Text="Panel de Administración" FontSize="26" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock Text="Gestiona usuarios y configuración global de la aplicación."
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,0,0,28"/>

            <!-- ── Usuarios ── -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Usuarios registrados" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Activa/desactiva cuentas o elimínalas junto con todos sus datos."
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding ErrorUsuarios}"
                               Foreground="{DynamicResource RedBrush}"
                               FontSize="12" Margin="0,0,0,12"
                               Visibility="{Binding ErrorUsuariosVisibility}"/>

                    <!-- Cabecera -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Usuario" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Rol"     Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Estado"  Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Creado"  Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text=""         />
                        <TextBlock Grid.Column="5" Text=""         />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Usuarios}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding NombreUsuario}"
                                                   FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>

                                        <!-- Badge rol -->
                                        <Border Grid.Column="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Rol}" Value="Admin">
                                                            <Setter Property="Background" Value="{DynamicResource SelectedStrongBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Rol}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Rol}" Value="Admin">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Estado -->
                                        <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"       Value="Activo"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Activo}" Value="False">
                                                            <Setter Property="Text"       Value="Inactivo"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding FechaCreacion, StringFormat='{}{0:dd/MM/yyyy}'}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="12" VerticalAlignment="Center"/>

                                        <!-- Toggle activo -->
                                        <Button Grid.Column="4"
                                                Padding="8,4" VerticalAlignment="Center"
                                                Command="{Binding DataContext.ToggleActivoCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                    <Setter Property="Content" Value="Desactivar"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Activo}" Value="False">
                                                            <Setter Property="Content" Value="Activar"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Eliminar -->
                                        <Button Grid.Column="5"
                                                Content="Eliminar"
                                                Style="{StaticResource DangerButton}"
                                                Padding="8,4" VerticalAlignment="Center"
                                                Command="{Binding DataContext.EliminarUsuarioCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

            <!-- ── Configuración global ── -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Configuración global" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Estos valores aplican para toda la aplicación."
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,20"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Símbolo de moneda"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding Moneda, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="ej: ₡, $, €"
                                 MaxLength="5"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Máximo de usuarios"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding MaxUsuarios, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="1-999"/>
                    </Grid>

                    <Button Content="Guardar configuración"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding GuardarConfigCommand}"
                            HorizontalAlignment="Left"
                            Padding="24,10"/>

                    <TextBlock Text="{Binding ErrorConfig}"
                               Foreground="{DynamicResource RedBrush}"
                               FontSize="12" Margin="0,10,0,0"
                               Visibility="{Binding ErrorConfigVisibility}"/>

                    <TextBlock Text="{Binding OkConfig}"
                               Foreground="{DynamicResource GreenBrush}"
                               FontSize="12" Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding OkConfigVisibility}"/>
                </StackPanel>
            </Border>

            <!-- ── Copias de seguridad ── -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Copias de seguridad" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Cada día, al abrir la aplicación, se guarda sola una copia de todos los datos (se conservan las últimas 30). Esas copias están en este mismo equipo: para protegerte si se daña o se pierde, guarda de vez en cuando una copia fuera de él, en un USB, OneDrive o tu correo."/>

                    <TextBlock Text="{Binding CopiasResumen}" FontSize="13" Margin="0,0,0,14"/>

                    <WrapPanel>
                        <Button Content="Guardar copia en…"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding GuardarCopiaCommand}"
                                Padding="20,10" Margin="0,0,10,8"/>
                        <Button Content="Abrir carpeta de copias"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding AbrirCarpetaCopiasCommand}"
                                Padding="20,10" Margin="0,0,10,8"/>
                        <Button Content="Restaurar una copia…"
                                Style="{StaticResource DangerButton}"
                                Command="{Binding RestaurarCopiaCommand}"
                                Padding="20,10" FontSize="13" Margin="0,0,0,8"/>
                    </WrapPanel>

                    <TextBlock Text="{Binding CopiasMensaje}"
                               Foreground="{Binding CopiasMensajeColor}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding CopiasMensajeVisibility}"/>
                </StackPanel>
            </Border>

            <!-- ── Diagnóstico de integridad ── -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Diagnóstico de integridad" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Comprueba que los saldos de cuentas y tarjetas cuadren con las transacciones, y busca referencias rotas. Es solo lectura: no modifica nada."
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Button Content="Ejecutar diagnóstico"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding EjecutarDiagnosticoCommand}"
                            HorizontalAlignment="Left"
                            Padding="24,10"/>

                    <TextBlock Text="{Binding DiagnosticoResumen}"
                               Foreground="{Binding DiagnosticoColor}"
                               FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,16,0,0"
                               Visibility="{Binding DiagnosticoResumenVisibility}"/>

                    <ItemsControl ItemsSource="{Binding Problemas}"
                                  Margin="0,12,0,0"
                                  Visibility="{Binding DiagnosticoListaVisibility}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Background="{Binding SeveridadColor}"
                                                    CornerRadius="4" Padding="6,1" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding SeveridadTexto}"
                                                           Foreground="{DynamicResource TextOnColorBrush}"
                                                           FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Area}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Descripcion}"
                                                   FontSize="13" TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding Detalle}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
