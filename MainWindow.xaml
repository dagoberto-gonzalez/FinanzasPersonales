<Window x:Class="FinanzasPersonales.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DMT Finance"
        Icon="/Assets/dmt-logo.png"
        Width="1340" Height="820"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Window.Resources>
        <!-- ── Grupo de navegación colapsable ─────────────────────────────── -->
        <Style x:Key="NavExpander" TargetType="Expander">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>

                            <!--
                                    El ToggleButton ES el header completo.
                                    Así su IsMouseOver sólo cubre la cabecera,
                                    no los botones de navegación que están debajo.
                            -->
                            <ToggleButton
                                IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                            RelativeSource={RelativeSource TemplatedParent}}"
                                Content="{TemplateBinding Header}"
                                Cursor="Hand" Focusable="False" OverridesDefaultStyle="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBd"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="14,8,14,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="HeaderText"
                                                           Grid.Column="0"
                                                           Text="{TemplateBinding Content}"
                                                           Foreground="#A8B3CF"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <Path x:Name="Chevron"
                                                      Grid.Column="1"
                                                      Data="M 0 0 L 5 5 L 10 0"
                                                      Stroke="#A8B3CF"
                                                      StrokeThickness="2"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform x:Name="ChevronRotate" Angle="-90"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!-- Hover: texto y flecha en morado claro + fondo sutil -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBd"   Property="Background"  Value="#22183A"/>
                                                <Setter TargetName="HeaderText" Property="Foreground"  Value="{StaticResource AccentLightBrush}"/>
                                                <Setter TargetName="Chevron"    Property="Stroke"      Value="{StaticResource AccentLightBrush}"/>
                                            </Trigger>
                                            <!-- Chevron: girar al expandir (IsChecked == IsExpanded) -->
                                            <Trigger Property="IsChecked" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetName="ChevronRotate"
                                                                Storyboard.TargetProperty="Angle"
                                                                To="0" Duration="0:0:0.22">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetName="ChevronRotate"
                                                                Storyboard.TargetProperty="Angle"
                                                                To="-90" Duration="0:0:0.16">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseIn"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Contenido animado (sólo MaxHeight aquí) -->
                            <Border x:Name="ContentBorder"
                                    MaxHeight="0"
                                    ClipToBounds="True">
                                <ContentPresenter Margin="0,0,0,4"/>
                            </Border>

                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <!-- Animación del contenido según IsExpanded -->
                            <Trigger Property="IsExpanded" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ContentBorder"
                                                Storyboard.TargetProperty="MaxHeight"
                                                To="600" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ContentBorder"
                                                Storyboard.TargetProperty="MaxHeight"
                                                To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Barra lateral ──────────────────────────────────────────────── -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo / Título / Usuario -->
                <StackPanel Grid.Row="0" Margin="22,24,22,20">
                    <!-- Logo DMT Finance -->
                    <Viewbox Width="38" Height="38">
                        <Canvas Width="64" Height="64">
                            <Rectangle Width="64" Height="64" RadiusX="14" RadiusY="14" Fill="#7C3AED"/>
                            <Rectangle Canvas.Left="9"  Canvas.Top="43" Width="13" Height="12" RadiusX="2.5" RadiusY="2.5" Fill="#66FFFFFF"/>
                            <Rectangle Canvas.Left="26" Canvas.Top="31" Width="13" Height="24" RadiusX="2.5" RadiusY="2.5" Fill="#A6FFFFFF"/>
                            <Rectangle Canvas.Left="43" Canvas.Top="17" Width="13" Height="38" RadiusX="2.5" RadiusY="2.5" Fill="White"/>
                            <Polyline Points="15.5,41 32.5,29 49.5,15"
                                      Stroke="White" StrokeThickness="2" Opacity="0.85"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            <Ellipse Canvas.Left="46.5" Canvas.Top="12" Width="6" Height="6" Fill="White" Opacity="0.9"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="DMT Finance"
                               FontSize="19" FontWeight="Bold"
                               Margin="0,8,0,2"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Hola, "
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12"/>
                        <TextBlock x:Name="TxtUsuario"
                                   Foreground="{StaticResource AccentLightBrush}"
                                   FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <!-- Badge de rol -->
                    <Border x:Name="BadgeAdmin"
                            CornerRadius="4" Padding="6,2" Margin="0,4,0,0"
                            Background="#3D2A6E" HorizontalAlignment="Left"
                            Visibility="Collapsed">
                        <TextBlock Text="ADMIN" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentLightBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Navegación -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="10,4,10,0">

                        <!-- ── General ─────────────────────────────────────── -->
                        <Expander x:Name="ExpGeneral"
                                  Style="{StaticResource NavExpander}"
                                  Header="GENERAL"
                                  IsExpanded="True">
                            <StackPanel>
                                <Button x:Name="BtnDashboard"
                                        Style="{StaticResource NavButton}"
                                        Click="BtnDashboard_Click"
                                        IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F4CA;" FontSize="15" FontFamily="Segoe UI Emoji"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="  Dashboard" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnTransacciones"
                                        Style="{StaticResource NavButton}"
                                        Click="BtnTransacciones_Click"
                                        Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F4B8;" FontSize="15" FontFamily="Segoe UI Emoji"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="  Transacciones" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnMetas"
                                        Style="{StaticResource NavButton}"
                                        Click="BtnMetas_Click"
                                        Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F3AF;" FontSize="15" FontFamily="Segoe UI Emoji"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="  Metas de Ahorro" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnCategorias"
                                        Style="{StaticResource NavButton}"
                                        Click="BtnCategorias_Click"
                                        Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F3F7;" FontSize="15" FontFamily="Segoe UI Emoji"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="  Categorías" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <!-- ── Recurrentes ──────────────────────────────────── -->
                        <Expander x:Name="ExpRecurrentes"
                                  Style="{StaticResource NavExpander}"
                                  Header="RECURRENTES"
                                  Margin="0,2,0,0">
                            <StackPanel>
                                <Button x:Name="BtnGastosFijos"
                                        Style="{StaticResource NavButton}"
                                        Click="BtnGastosFijos_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F4CC;" FontSize="15" FontFamily="Segoe UI Emoji"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="  Gastos Fijos" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnIngresosFijos"
                                        Style="{StaticResource NavButton}"
                                        Click="BtnIngresosFijos_Click"
                                        Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F4B0;" FontSize="15" FontFamily="Segoe UI Emoji"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="  Ingresos Fijos" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <!-- ── Laboral ──────────────────────────────────────── -->
                        <Expander x:Name="ExpLaboral"
                                  Style="{StaticResource NavExpander}"
                                  Header="LABORAL"
                                  Margin="0,2,0,0">
                            <StackPanel>
                                <Button x:Name="BtnControlLaboral"
                                        Style="{StaticResource NavButton}"
                                        Click="BtnControlLaboral_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F4BC;" FontSize="15" FontFamily="Segoe UI Emoji"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="  Control Laboral" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <!-- ── Finanzas ─────────────────────────────────────── -->
                        <Expander x:Name="ExpFinanzas"
                                  Style="{StaticResource NavExpander}"
                                  Header="FINANZAS"
                                  Margin="0,2,0,0">
                            <StackPanel>
                                <Button x:Name="BtnTarjetas"
                                        Style="{StaticResource NavButton}"
                                        Click="BtnTarjetas_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F4B3;" FontSize="15" FontFamily="Segoe UI Emoji"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="  Tarjetas de Crédito" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnCuentas"
                                        Style="{StaticResource NavButton}"
                                        Click="BtnCuentas_Click"
                                        Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F3E6;" FontSize="15" FontFamily="Segoe UI Emoji"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="  Cuentas" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnReportes"
                                        Style="{StaticResource NavButton}"
                                        Click="BtnReportes_Click"
                                        Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F4C8;" FontSize="15" FontFamily="Segoe UI Emoji"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="  Reportes" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                        <!-- ── Cuenta ───────────────────────────────────────── -->
                        <Expander x:Name="ExpCuenta"
                                  Style="{StaticResource NavExpander}"
                                  Header="CUENTA"
                                  Margin="0,2,0,0">
                            <StackPanel>
                                <Button x:Name="BtnCambiarPwd"
                                        Style="{StaticResource NavButton}"
                                        Click="BtnCambiarPwd_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F510;" FontSize="15" FontFamily="Segoe UI Emoji"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="  Cambiar Contraseña" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnAdmin"
                                        Style="{StaticResource NavButton}"
                                        Click="BtnAdmin_Click"
                                        Margin="0,2,0,0"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x2699;" FontSize="15" FontFamily="Segoe UI Emoji"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="  Panel Admin" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>

                <!-- Pie: cerrar sesión + versión -->
                <StackPanel Grid.Row="2" Margin="10,0,10,14">
                    <Button x:Name="BtnCerrarSesion"
                            Click="BtnCerrarSesion_Click"
                            Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F6AA;" FontSize="15" FontFamily="Segoe UI Emoji"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource RedBrush}"/>
                            <TextBlock Text="  Cerrar sesión" VerticalAlignment="Center"
                                       Foreground="{StaticResource RedBrush}"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="v3.0.0"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Contenido principal ────────────────────────────────────────── -->
        <ContentControl x:Name="MainContent" Grid.Column="1"/>

    </Grid>
</Window>
